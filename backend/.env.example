# =============================================================================
# CityMind AI CITY Enterprise Backend Configuration Template
# Safe for version control — placeholder values only
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Required in production)
# In development, falls back to local daemon or embedded MongoMemoryServer
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aicity?retryWrites=true&w=majority"

# Gemini AI Engine (Required for autonomous incident analysis)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_NAME=gemini-2.0-flash

# CORS Allowed Origins (Comma-separated list of whitelisted origins)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://city-mind-ecru.vercel.app"

# Developer Mock Authentication Bypass (DEF-SEC-02)
# Set to 'true' to permit demo role profiles (Commissioner Rajesh Kumar, Officer, Citizen)
ENABLE_DEV_AUTH="true"

# Firebase Admin SDK Credentials (Base64-encoded service account JSON)
# Optional in development when ENABLE_DEV_AUTH="true"; required in production
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# Cloudinary Storage CDN
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Neo4j Graph Database
# Optional: system automatically falls back to In-Memory Graph Emulator if offline
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"
