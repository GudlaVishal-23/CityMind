{
  "name": "aicity-backend",
  "version": "1.0.0",
  "description": "AI CITY: An Agentic AI Operating System for Autonomous Civic Operations Backend Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node -r ts-node/register --test \"src/**/__tests__/*.test.ts\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@langchain/langgraph": "^0.0.25",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.13.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^12.1.0",
    "helmet": "^7.1.0",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^8.3.2",
    "morgan": "^1.10.0",
    "neo4j-driver": "^5.20.0",
    "pdfkit": "^0.15.0",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.4.5",
    "winston": "^3.13.0",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "rimraf": "^5.0.5",
    "supertest": "^7.3.2",
    "ts-node-dev": "^2.0.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
